{
  "name": "spirit-call",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "lint": "oxlint src test tools/lint/plugin.mjs tools/progress tools/store",
    "test": "vitest run",
    "lint:game": "NODE_OPTIONS='--import tsx --import ./scripts/assets.ts' ritmo-devtools lint scripts/lint-target.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:game && pnpm test",
    "debug": "node --import tsx --import ./scripts/assets.ts scripts/debug.ts",
    "lab": "node --import tsx --import ./scripts/assets.ts scripts/lab.ts",
    "calls": "node --import tsx --import ./scripts/assets.ts scripts/calls.ts",
    "progression": "node --import tsx --import ./scripts/assets.ts scripts/progression.ts",
    "expected": "node --import tsx --import ./scripts/assets.ts scripts/expected.ts",
    "runs": "node --import tsx --import ./scripts/assets.ts scripts/runs.ts",
    "db": "node --import tsx --import ./scripts/assets.ts scripts/db.ts",
    "balance": "node --import tsx --import ./scripts/assets.ts scripts/balance.ts",
    "shot": "node --import tsx --import ./scripts/assets.ts scripts/screenshot.ts",
    "perf": "node --import tsx scripts/perf.ts",
    "effect-source": "node scripts/effect-source.ts",
    "app": "vite build && cap sync",
    "app:android": "pnpm app && cap open android",
    "app:ios": "pnpm app && cap open ios",
    "app:assets": "capacitor-assets generate --android --ios --iconBackgroundColor '#072845' --iconBackgroundColorDark '#072845' --splashBackgroundColor '#0d1117' --splashBackgroundColorDark '#0d1117'",
    "release": "pnpm --dir deploy release",
    "engine:prepare": "node scripts/use-ritmo.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@effect/platform-browser": "4.0.2",
    "@effect/sql-d1": "4.0.2",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@preact/signals": "2.11.3",
    "@typeonce/ritmo": "link:.repos/ritmo-preview/46ea1cb4b4772e1b42e4b11d1a1775c99cc032f9/packages/core",
    "@typeonce/ritmo-browser": "link:.repos/ritmo-preview/46ea1cb4b4772e1b42e4b11d1a1775c99cc032f9/packages/browser",
    "@typeonce/ritmo-math": "link:.repos/ritmo-preview/46ea1cb4b4772e1b42e4b11d1a1775c99cc032f9/packages/math",
    "@typeonce/ritmo-render": "link:.repos/ritmo-preview/46ea1cb4b4772e1b42e4b11d1a1775c99cc032f9/packages/render",
    "effect": "4.0.2",
    "preact": "11.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@effect/sql-sqlite-node": "4.0.2",
    "@typeonce/oxlint-plugin-ritmo": "link:.repos/ritmo-preview/46ea1cb4b4772e1b42e4b11d1a1775c99cc032f9/packages/oxlint-plugin",
    "@typeonce/ritmo-devtools": "link:.repos/ritmo-preview/46ea1cb4b4772e1b42e4b11d1a1775c99cc032f9/packages/devtools",
    "@types/node": "25.5.0",
    "@types/three": "0.186.0",
    "oxlint": "1.87.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.34.5"
    }
  },
  "ritmoRelease": "0.8.0",
  "ritmoSource": "46ea1cb4b4772e1b42e4b11d1a1775c99cc032f9"
}
