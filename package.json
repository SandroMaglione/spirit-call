{
  "name": "top-down-team-shooter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "bevyTsRelease": "0.3.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
