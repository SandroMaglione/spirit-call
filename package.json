{
  "name": "top-down-team-shooter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "bevyTsRelease": "0.4.0",
  "bevyTsSource": "4713b7ec05cd32bf22f71c227f221bddfb01643c",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "lint": "oxlint src test tools/lint/plugin.mjs tools/progress tools/store",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "debug": "node --import tsx --import ./scripts/assets.ts scripts/debug.ts",
    "lab": "node --import tsx --import ./scripts/assets.ts scripts/lab.ts",
    "calls": "node --import tsx --import ./scripts/assets.ts scripts/calls.ts",
    "progression": "node --import tsx --import ./scripts/assets.ts scripts/progression.ts",
    "expected": "node --import tsx --import ./scripts/assets.ts scripts/expected.ts",
    "runs": "node --import tsx --import ./scripts/assets.ts scripts/runs.ts",
    "db": "node --import tsx --import ./scripts/assets.ts scripts/db.ts",
    "balance": "node --import tsx --import ./scripts/assets.ts scripts/balance.ts",
    "shot": "node --import tsx --import ./scripts/assets.ts scripts/screenshot.ts",
    "effect-source": "node scripts/effect-source.ts",
    "app": "vite build && cap sync",
    "app:android": "pnpm app && cap open android",
    "app:ios": "pnpm app && cap open ios",
    "app:assets": "capacitor-assets generate --android --ios --iconBackgroundColor '#072845' --iconBackgroundColorDark '#072845' --splashBackgroundColor '#0d1117' --splashBackgroundColorDark '#0d1117'"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@effect/platform-browser": "4.0.2",
    "@effect/sql-d1": "4.0.2",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@preact/signals": "2.11.3",
    "@typeonce/bevy-ts": "link:../../bevy-ts/packages/core",
    "@typeonce/bevy-ts-browser": "link:../../bevy-ts/packages/browser",
    "@typeonce/bevy-ts-math": "link:../../bevy-ts/packages/math",
    "@typeonce/bevy-ts-render": "link:../../bevy-ts/packages/render",
    "effect": "4.0.2",
    "preact": "11.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@effect/sql-sqlite-node": "4.0.2",
    "@typeonce/bevy-ts-devtools": "link:../../bevy-ts/packages/devtools",
    "@types/node": "25.5.0",
    "@types/three": "0.186.0",
    "oxlint": "1.87.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.34.5"
    }
  }
}
